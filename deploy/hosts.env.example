# ─────────────────────────────────────────────────────────────────────────────
# hosts.env — the machines, by ROLE, and nothing else. Copy to deploy/hosts.env
# (git-ignored), fill in, and use the same file on every machine. Moving a role
# to another machine or cloud later = edit one line.
#
# Addresses must be reachable from every machine and from the containers on
# them: Tailscale IPs (100.x.y.z) or MagicDNS names, or public addresses.
# Several roles may share one machine (e.g. EDGE and SOURCE on one laptop).
# ─────────────────────────────────────────────────────────────────────────────

# ── Roles ────────────────────────────────────────────────────────────────────
EDGE_HOST=100.a.b.c        # factory edge server (VM 1): provider CP/DP when "edge"
SOURCE_HOST=100.a.b.d      # factory data source (VM 2): simulator + AAS, every arch
CLOUD_HOST=100.x.y.z       # provider cloud (cPouta): provider CP/DP when "cloud"
CONSUMER_HOST=100.p.q.r    # external partner (Contabo): consumer CP + DP + receiver

DASHBOARD_ROLE=edge        # which role's machine also runs the dashboard

# ── Port binding (optional) ──────────────────────────────────────────────────
# Each role publishes its ports on its own address above (so with Tailscale IPs,
# only on the Tailscale interface). Override when the address is a DNS name or
# a NAT'd public IP, e.g.  CLOUD_BIND=0.0.0.0
# EDGE_BIND=  SOURCE_BIND=  CLOUD_BIND=  CONSUMER_BIND=

# ── SSH access for the measurement scripts ───────────────────────────────────
# How the machine running the tests reaches each role's machine (clock offset,
# CPU/RAM, consumer database). Empty = the machine running the tests itself.
# ssh arguments, e.g. "ubuntu@100.x.y.z -i $HOME/.ssh/id_ed25519_cpouta".
# The project must be at ~/<same folder name> on every machine (or set REMOTE_DIR).
EDGE_SSH=
SOURCE_SSH=
CLOUD_SSH=
CONSUMER_SSH=

# ── Resource limits per connector container, by role ─────────────────────────
# The thesis runs used 4 CPUs and 4 GB for every connector container
# (recorded in each run's meta.json); a smaller edge limit models a
# resource-constrained edge device but was not part of the measurements.
EDGE_CPU=4.0
EDGE_MEM=4096m
CLOUD_CPU=4.0
CLOUD_MEM=4096m
CONSUMER_CPU=4.0
CONSUMER_MEM=4096m
