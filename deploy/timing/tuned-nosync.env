# Timing profile: tuned-nosync — as tuned, and every connector database runs
# with synchronous_commit=off: a commit no longer waits for the disk to confirm
# the write. A diagnostic, not a production setting: it shows how much of a
# machine's result comes from slow storage (the TAU VMs' disks take 25–130 ms
# per synchronous write, cPouta's 1.7 ms, Contabo's 0.5 ms; 2026-10-08).
EDC_TRANSFER_WAIT_MS=50
EDC_NEGOTIATION_WAIT_MS=
DB_SYNCHRONOUS_COMMIT=off
