# Timing profile: neg-provider — tuned transfers, and only the provider's
# negotiation state machine at 50 ms. The provider persists the agreement
# sooner while the consumer still verifies on EDC's default 1 s tick — an
# attempt to avoid the race seen with neg-both.
EDC_TRANSFER_WAIT_MS=50
EDC_PROVIDER_NEGOTIATION_WAIT_MS=50
