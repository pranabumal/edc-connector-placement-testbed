# Timing profile: tuned — short state-machine wait for transfers.
# With the default 1000 ms, each step of a transfer waits for the next tick,
# which hides the effect of where the planes run. A short wait removes that
# fixed delay, at the cost of polling the database more often (visible in the
# CPU measurements).
#
# Applies to the transfer-process (Control Plane) and data-flow (Data Plane)
# state machines — the ones every transfer goes through.
EDC_TRANSFER_WAIT_MS=50

# Negotiation stays at EDC's default. With a short wait the consumer sends its
# ContractAgreementVerificationMessage before a provider one WAN hop away has
# persisted the agreement; the provider answers 409 and EDC terminates the
# negotiation instead of retrying (seen 2026-10-02, consumer 45 ms from the
# provider's Control Plane). Negotiation is paid once per agreement, not per
# transfer.
EDC_NEGOTIATION_WAIT_MS=
